# Copy to .env, add real values only to the local ignored file.
# These keys are for the future Puro Python application, not Task Master AI.
PUROLATOR_ENV=development
# Both flags deliberately OFF: do not turn on without authorized local validation.
PURO_ENABLE_CARRIER=false
PURO_PRODUCTION_APPROVED=false
PUROLATOR_API_KEY=
PUROLATOR_API_PASSWORD=
PUROLATOR_ACCOUNT_NUMBER=
PUROLATOR_WSDL_DIR=
DEFAULT_SENDER_NAME=
DEFAULT_SENDER_STREET_NO=
DEFAULT_SENDER_STREET=
DEFAULT_SENDER_CITY=
DEFAULT_SENDER_PROVINCE=ON
DEFAULT_SENDER_POSTAL_CODE=
DEFAULT_SENDER_COUNTRY=CA
DEFAULT_SENDER_PHONE=
PURO_DATA_DIR=./local_data
PURO_LABELS_DIR=./local_data/labels

# Optional TASK MASTER AI provider credentials (choose your supported provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Task Master is initially configured for codex-cli, which requires a locally authenticated Codex CLI.
